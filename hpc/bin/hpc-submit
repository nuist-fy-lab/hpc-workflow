#!/usr/bin/env bash
# Explicit-resource Slurm launcher; intentionally independent of the CI runner.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  hpc-submit --partition PART --cpus N --mem 16G --time 02:00:00 \
    --image /shared/runtime.sif [--overlay /shared/env.ext3] \
    [--dataset /shared/tiles.sqsh] [--gres gpu:v100:1] \
    [--nodes N] [--job-name NAME] [--ray] [--ray-gpus N] [--dry-run] \
    -- COMMAND [ARGS...]

For Ray: --ray requires --nodes >= 2, exclusive nodes are requested automatically,
and COMMAND must be the executable (e.g. python -u /shared/train.py).
For GPU: request a Slurm GRES explicitly; the compute script then enables --nv.
No default partition, CPU, memory, GPU, or walltime is assumed for research.
EOF
}
die() { printf 'hpc-submit: %s\n' "$*" >&2; exit 2; }
partition= cpus= mem= walltime= image= overlay= dataset= gres=
nodes=1 job_name=hpc-research ray=0 ray_gpus=0 dry_run=0
while (($#)); do
  case "$1" in
    --partition|--cpus|--mem|--time|--image|--overlay|--dataset|--gres|--nodes|--job-name|--ray-gpus)
      (($# >= 2)) || die "missing value after $1"
      case "$1" in
        --partition) partition=$2;; --cpus) cpus=$2;; --mem) mem=$2;;
        --time) walltime=$2;; --image) image=$2;; --overlay) overlay=$2;;
        --dataset) dataset=$2;; --gres) gres=$2;; --nodes) nodes=$2;;
        --job-name) job_name=$2;; --ray-gpus) ray_gpus=$2;;
      esac
      shift 2;;
    --ray) ray=1; shift;; --dry-run) dry_run=1; shift;;
    --help|-h) usage; exit 0;;
    --) shift; break;;
    *) die "unknown argument $1";;
  esac
done
[[ -n $partition && -n $cpus && -n $mem && -n $walltime && -n $image ]] || die 'partition, cpus, mem, time, image required'
[[ $partition =~ ^[a-zA-Z0-9_-]+$ ]] || die 'invalid partition'
[[ $cpus =~ ^[1-9][0-9]*$ && $nodes =~ ^[1-9][0-9]*$ && $ray_gpus =~ ^[0-9]+$ ]] || die 'invalid resource count'
[[ $job_name =~ ^[a-zA-Z0-9_.-]+$ ]] || die 'invalid job name'
[[ $mem =~ ^[1-9][0-9]*[KMGTP]?$ ]] || die 'invalid memory size'
[[ $walltime =~ ^([0-9]+-)?[0-9]{1,2}:[0-9]{2}:[0-9]{2}$ ]] || die 'time must be HH:MM:SS or D-HH:MM:SS'
[[ $# -gt 0 ]] || die 'missing command after --'
[[ $image == /* ]] || die 'image must be an absolute path'
[[ -f $image ]] || die "image does not exist: $image"
if [[ -n $overlay ]]; then
  [[ $overlay == /* && -f $overlay ]] || die 'overlay must be an existing absolute path'
fi
if [[ -n $dataset ]]; then
  [[ $dataset == /* && -f $dataset ]] || die 'dataset must be an existing absolute path'
fi
if [[ -n $gres ]]; then
  [[ $gres =~ ^gpu(:[a-zA-Z0-9_.-]+)?:[1-9][0-9]*$ ]] || die 'GRES format must be gpu[:TYPE]:COUNT'
fi
if ((ray)); then
  ((nodes >= 2)) || die 'Ray multi-node mode requires --nodes >= 2'
  if ((ray_gpus > 0)); then
    [[ -n $gres ]] || die '--ray-gpus needs --gres'
    ((ray_gpus <= ${gres##*:})) || die '--ray-gpus exceeds requested GRES GPUs'
  fi
else
  ((nodes == 1)) || die 'multi-node execution requires --ray'
  ((ray_gpus == 0)) || die '--ray-gpus requires --ray'
fi
script_path=$(readlink -f -- "${BASH_SOURCE[0]}")
[[ -n $script_path ]] || die 'cannot resolve the installed launcher path'
script_dir=$(cd -- "$(dirname -- "$script_path")" && pwd)
job_script="$script_dir/../slurm/$( ((ray)) && printf ray || printf container ).sbatch"
[[ -f $job_script ]] || die "missing job script: $job_script"
log_dir="${HPC_LOG_DIR:-$HOME/.local/state/hpc-workflow/logs}"
if (( ! dry_run )); then mkdir -p -- "$log_dir"; fi
tasks=1
if ((ray)); then tasks=$nodes; fi
opts=(--parsable --partition="$partition" --job-name="$job_name"
  --nodes="$nodes" --ntasks="$tasks" --cpus-per-task="$cpus"
  --mem="$mem" --time="$walltime"
  --output="$log_dir/%x-%j.out" --error="$log_dir/%x-%j.err")
if [[ -n $gres ]]; then opts+=(--gres="$gres"); fi
if ((ray)); then opts+=(--exclusive); fi
gpu_enabled=0
if [[ -n $gres ]]; then gpu_enabled=1; fi
command=(sbatch "${opts[@]}" "$job_script" "$image" "$overlay" "$dataset" "$gpu_enabled" "$ray_gpus" -- "$@")
if ((dry_run)); then
  printf '%q ' "${command[@]}"; printf '\n'
else
  "${command[@]}"
fi
